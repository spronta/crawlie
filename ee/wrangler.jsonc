{
  // Crawlie Cloud auth Worker. Deploys to api.crawlie.app (the crawlie.app zone
  // lives on Cloudflare, so the custom domain below auto-provisions on deploy).
  //
  // Secrets (set with `wrangler secret put <NAME>`, never commit them):
  //   BETTER_AUTH_SECRET     — 32+ byte random string (openssl rand -base64 32)
  //   GITHUB_CLIENT_ID       — GitHub OAuth app client id
  //   GITHUB_CLIENT_SECRET   — GitHub OAuth app client secret
  //   LOOPS_API_KEY          — Loops.so API key (transactional OTP + newsletter)
  //
  // Non-secret config lives in `vars` below. Local dev reads `.dev.vars`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crawlie-auth",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Bind the Worker to api.crawlie.app. Requires the crawlie.app zone on this
  // Cloudflare account; `wrangler deploy` provisions the domain + cert.
  "routes": [{ "pattern": "api.crawlie.app", "custom_domain": true }],
  "vars": {
    "BETTER_AUTH_URL": "https://api.crawlie.app",
    // Comma-separated origins allowed to call the auth API with credentials:
    // the marketing site (crawlie.dev, Vercel), the future crawlie.app dashboard,
    // the desktop app, and localhost dev servers.
    "TRUSTED_ORIGINS": "https://crawlie.dev,https://www.crawlie.dev,https://crawlie.app,https://www.crawlie.app,http://localhost:4321,http://localhost:5173,tauri://localhost",
    // Loops mailing list id for the Crawlie product newsletter.
    "LOOPS_NEWSLETTER_MAILING_LIST_ID": "cmqw5b5y06otv0jybbg8x30xj",
    // Loops transactional email id used to deliver the sign-in code.
    "LOOPS_OTP_TRANSACTIONAL_ID": "cmrb5h8dy00qb0jx3qsb2wqfx",
    // Whether to subscribe new cloud signups to the newsletter (opt-out).
    "LOOPS_NEWSLETTER_ON_SIGNUP": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crawlie-auth",
      // Created via `wrangler d1 create crawlie-auth` (region WEUR).
      "database_id": "d0130009-7642-44df-bbc9-acf9cc1f926e",
      "migrations_dir": "migrations"
    }
  ]
}
