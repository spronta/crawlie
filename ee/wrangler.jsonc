{
  // Crawlie Cloud auth Worker. Deploys to api.crawlie.app (the crawlie.app zone
  // lives on Cloudflare, so the custom domain below auto-provisions on deploy).
  //
  // Secrets (set with `wrangler secret put <NAME>`, never commit them):
  //   BETTER_AUTH_SECRET     — 32+ byte random string (openssl rand -base64 32)
  //   GITHUB_CLIENT_ID       — GitHub OAuth app client id
  //   GITHUB_CLIENT_SECRET   — GitHub OAuth app client secret
  //   LOOPS_API_KEY          — Loops.so API key (transactional OTP + newsletter)
  //
  // Non-secret config lives in `vars` below. Local dev reads `.dev.vars`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crawlie-auth",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One Worker serves the whole of Crawlie Cloud:
  //   crawlie.app      → the dashboard SPA (below) + first-party auth + /v1 API
  //   api.crawlie.app  → same Worker, kept so already-shipped CLI/MCP/desktop
  //                      clients that point at api.crawlie.app keep working.
  "routes": [
    { "pattern": "crawlie.app", "custom_domain": true },
    { "pattern": "api.crawlie.app", "custom_domain": true }
  ],
  // The built dashboard is served as static assets. API + device + health hit
  // the Worker first (run_worker_first); every other path falls back to the SPA
  // (single-page-application → index.html) so client-side routing works.
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/pub/*", "/device", "/health"]
  },
  "vars": {
    // Auth is first-party on the apex so the session cookie is same-origin with
    // the dashboard. crossSubDomainCookies (domain .crawlie.app) also makes it
    // valid on api.crawlie.app for the CLI/desktop device flow.
    "BETTER_AUTH_URL": "https://crawlie.app",
    // Comma-separated origins allowed to call the auth API with credentials:
    // the marketing site (crawlie.dev, Vercel), the future crawlie.app dashboard,
    // the desktop app, and localhost dev servers.
    "TRUSTED_ORIGINS": "https://crawlie.dev,https://www.crawlie.dev,https://crawlie.app,https://www.crawlie.app,http://localhost:4321,http://localhost:5173,tauri://localhost",
    // Loops mailing list id for the Crawlie product newsletter.
    "LOOPS_NEWSLETTER_MAILING_LIST_ID": "cmqw5b5y06otv0jybbg8x30xj",
    // Loops transactional email id used to deliver the sign-in code.
    "LOOPS_OTP_TRANSACTIONAL_ID": "cmrb5h8dy00qb0jx3qsb2wqfx",
    // Whether to subscribe new cloud signups to the newsletter (opt-out).
    "LOOPS_NEWSLETTER_ON_SIGNUP": "true",
    // Loops transactional template for scheduled-crawl regression alerts.
    "LOOPS_ALERT_TRANSACTIONAL_ID": ""
  },
  // Monitoring engine: hourly scan for due scheduled project crawls.
  "triggers": { "crons": ["0 * * * *"] },
  "r2_buckets": [
    { "binding": "REPORTS", "bucket_name": "crawlie-reports" }
  ],
  // Hosted crawler: a container running ee/crawler, managed by the
  // CrawlerContainer Durable Object. wrangler builds + pushes the image
  // (Dockerfile at the repo root; build context is the repo root).
  "containers": [
    {
      "class_name": "CrawlerContainer",
      "image": "../Dockerfile",
      // 'basic' (≈1 GiB / 0.25 vCPU) — headroom for headless Chromium (JS
      // rendering) and ~4x faster crawls than 'lite'.
      "instance_type": "basic",
      "max_instances": 5,
      "name": "crawlie-crawler"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "CrawlerContainer", "name": "CRAWLER" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CrawlerContainer"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crawlie-auth",
      // Created via `wrangler d1 create crawlie-auth` (region WEUR).
      "database_id": "d0130009-7642-44df-bbc9-acf9cc1f926e",
      "migrations_dir": "migrations"
    }
  ]
}
